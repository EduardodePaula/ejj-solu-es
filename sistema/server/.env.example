# Copie este arquivo para .env e ajuste os valores.

PORT=4000

# Segredo usado para assinar os tokens de login (troque por um valor aleatório em produção)
JWT_SECRET=troque-por-um-segredo-aleatorio-grande

# Usuário administrador criado automaticamente na primeira vez que o servidor rodar
ADMIN_EMAIL=admin@ejjsolucoes.com.br
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para proteger o endpoint de cron (geração automática de mensalidades)
CRON_SECRET=troque-por-outro-segredo

# ---- Emissão de boletos ----
# "simulado" (padrão, não exige credenciais) ou "banco_inter"
BOLETO_PROVIDER=simulado

# Credenciais do Banco Inter (somente se BOLETO_PROVIDER=banco_inter)
# Obtidas no Internet Banking > API > Cobrança
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=./certs/inter-cert.pem
INTER_KEY_PATH=./certs/inter-key.pem
INTER_CONTA_CORRENTE=
