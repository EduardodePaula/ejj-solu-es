# Copie este arquivo para .env e ajuste os valores.

PORT=4000

# Segredo usado para assinar os tokens de login (troque por um valor aleatório em produção)
JWT_SECRET=troque-por-um-segredo-aleatorio-grande

# Usuário administrador criado automaticamente na primeira vez que o servidor rodar
ADMIN_EMAIL=admin@ejjsolucoes.com.br
ADMIN_PASSWORD=troque-esta-senha

# Segredo usado para proteger o endpoint de cron (geração automática de mensalidades)
CRON_SECRET=troque-por-outro-segredo

# ---- Emissão de boletos ----
# "simulado" (padrão, não exige credenciais) ou "banco_inter"
BOLETO_PROVIDER=simulado

# Credenciais do Banco Inter (somente se BOLETO_PROVIDER=banco_inter)
# Obtidas no Internet Banking > API > Cobrança
INTER_CLIENT_ID=
INTER_CLIENT_SECRET=
INTER_CERT_PATH=./certs/inter-cert.pem
INTER_KEY_PATH=./certs/inter-key.pem
INTER_CONTA_CORRENTE=

# ---- Redação do escopo do projeto por IA (opcional) ----
# Se configurada, o PDF do orçamento usa IA para escrever o parágrafo de
# "Escopo do projeto" automaticamente com base nos itens adicionados. Sem
# nenhuma chave preenchida, o sistema usa um texto automático mais simples
# (sem IA) — o PDF funciona normalmente de qualquer jeito.

# Qual provedor usar: "claude" (padrão) ou "openai" (ChatGPT)
AI_PROVIDER=claude

# Preencha a chave do provedor escolhido acima (só uma é necessária)
# Claude: crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# ChatGPT: crie em https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Opcional — modelo do ChatGPT a usar (padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
# Opcional — para usar QUALQUER OUTRA IA compatível com o formato de API da
# OpenAI, em vez do ChatGPT: preencha com AI_PROVIDER=openai, a chave e o
# modelo daquele provedor em OPENAI_API_KEY/OPENAI_MODEL, e a URL da API dele
# aqui. Exemplos: Groq -> https://api.groq.com/openai/v1
#                 DeepSeek -> https://api.deepseek.com/v1
#                 OpenRouter -> https://openrouter.ai/api/v1
#                 Ollama local -> http://localhost:11434/v1
OPENAI_BASE_URL=
